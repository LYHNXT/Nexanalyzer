# Measurement data: spectra are .txt, and none of them belong in the repo.
*.txt
!requirements.txt
!requirements-dev.txt
!requirements-lock.txt
tests/fixtures/*.txt
# Except the golden-fit pair (HKU-20230524-2), cleared for the repo on 2026-10-09:
# the commit/push hooks refit them, so every clone must have them.
!tests/fixtures/golden_fit/*.txt
# And DDAA10 RM_1..3, the WSe2_QC golden set (v5.30.0, 2026-10-22).
!tests/fixtures/golden_fit/DDAA10/RM_[123].txt

# Per-installation "last used material" preference, regenerated on first use
# (unlike data/materials.json, which is shared and committed).
data/report_settings.json

# Per-installation "last used folder" for the Datalog and Runcard pages. These
# are nexanalyzer's own preferences and are deliberately NOT the sidecars those
# pages share with datalog_monitor -- runcard_tags.json and thresholds.json live
# in the user's data folder, travel with the data, and are read by both apps.
data/datalog.json
data/runcard.json

# Where each tool folder is on this PC (the Tools page). A OneDrive path carries
# the Windows user name; the relative layout, data/tool_layouts.json, is shared.
data/tool_roots.json

# Local Claude Code settings (per-developer, unlike .claude/commands/)
.claude/settings.local.json

# Sample data used for local testing of the Sample Report feature.
# Contains real customer QC sample data (photos, spectra, and a >100MB
# .wip project file that exceeds GitHub's per-file size limit anyway) —
# must never be committed.
/Example/

# Per-installation additions to the wafer-prefix -> material table, written by
# the OneNote page's "add this prefix" button. Deliberately NOT committed:
# data/material_prefixes.json is the team's shared, reviewed table, and a
# prefix added here is marked "not yet shared" everywhere it is rendered until
# someone promotes it into that file.
data/material_prefixes.local.json
